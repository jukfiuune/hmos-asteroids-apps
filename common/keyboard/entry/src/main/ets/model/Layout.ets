// Key geometry, shared by the page and the service that sizes its panel.
export const KEY_HEIGHT = 46;
export const ROW_GAP = 10;
export const KEY_GAP = 5;
export const PAD_TOP = 10;
export const PAD_BOTTOM = 6;
// Four rows and the column's padding: the panel is exactly this tall, so no empty band below the keys.
export const KEYBOARD_HEIGHT_VP = 4 * KEY_HEIGHT + 3 * ROW_GAP + PAD_TOP + PAD_BOTTOM;
