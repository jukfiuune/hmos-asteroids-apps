diff --git a/entry/src/main/ets/util/miniThumbCache.ets b/entry/src/main/ets/util/miniThumbCache.ets
new file mode 100644
index 0000000..a52610d
--- /dev/null
+++ b/entry/src/main/ets/util/miniThumbCache.ets
@@ -0,0 +1,51 @@
+import { image } from '@kit.ImageKit';
+import { util } from '@kit.ArkTS';
+import { logE } from './log';
+
+// Decoded minithumbnails, keyed by their data URL.
+//
+// Image(dataUrl) has no decoded-image cache behind it (the app never turns on
+// ArkUI's), so a recycled chat row decodes its ~40px JPEG again every time it
+// is rebound: on device, flinging the home list decoded the same ~14 previews
+// 217 times at ~4.7ms each on the image thread, and every decode re-dirtied
+// the row. Decoding the ~1KB JPEG here takes a fraction of a millisecond, once;
+// after that a rebind hands Image the same PixelMap and nothing is reloaded.
+//
+// 128 entries × 40×40×4 bytes ≈ 0.8MB.
+const MAX_ENTRIES: number = 128;
+const PREFIX: string = 'base64,';
+
+const cache: Map<string, image.PixelMap> = new Map();
+const base64: util.Base64Helper = new util.Base64Helper();
+
+// The PixelMap for a `data:image/...;base64,` URL, or the URL itself when it
+// can't be decoded (Image then loads it as before).
+export function miniThumbPixels(dataUrl: string): image.PixelMap | string {
+  const hit = cache.get(dataUrl);
+  if (hit !== undefined) {
+    // Map keeps insertion order: re-inserting makes this the newest entry.
+    cache.delete(dataUrl);
+    cache.set(dataUrl, hit);
+    return hit;
+  }
+  const at = dataUrl.indexOf(PREFIX);
+  if (at < 0) {
+    return dataUrl;
+  }
+  try {
+    const bytes: Uint8Array = base64.decodeSync(dataUrl.substring(at + PREFIX.length));
+    const source = image.createImageSource(bytes.buffer.slice(bytes.byteOffset, bytes.byteOffset + bytes.byteLength));
+    const pixels = source.createPixelMapSync();
+    source.release();
+    cache.set(dataUrl, pixels);
+    if (cache.size > MAX_ENTRIES) {
+      // Not released: a row that was just rebound may still be drawing it; the
+      // GC frees it once nothing holds it.
+      cache.delete(cache.keys().next().value as string);
+    }
+    return pixels;
+  } catch (e) {
+    logE('miniThumbCache', `decode failed: ${e}`);
+    return dataUrl;
+  }
+}
