 // Shared minute clock for every visible chat row. The parent page owns one
 // timer instead of each folder list starting its own interval.
 export const CHAT_LIST_NOW: string = 'chatListNowSec';
+// AppStorage flag: true while a chat list scrolls or flings (until its 120ms
+// settle). Rows read it with AppStorage.get, not @StorageProp, so flipping it
+// rebuilds nothing; their pulse timers skip ticks while it is set, since each
+// tick dirties the row and its cached surface mid-fling.
+export const CHAT_LIST_MOVING: string = 'chatListMoving';
+
+// Called on every scroll frame; only a change is written.
+export function setChatListMoving(moving: boolean): void {
+  if (AppStorage.get<boolean>(CHAT_LIST_MOVING) !== moving) {
+    AppStorage.setOrCreate<boolean>(CHAT_LIST_MOVING, moving);
+  }
+}
 
