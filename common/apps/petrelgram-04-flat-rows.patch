+// Whether a stored app background (a serialised ChatBackgroundState, see ChatBackgroundStore.serialiseSnapshot) is a
+// picture: its third field is the image path, empty for plain colours and gradients.
+export function appWallpaperIsPicture(stateRaw: string): boolean {
